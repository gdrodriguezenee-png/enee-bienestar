<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Solicitudes de Pago DBS 2026 — ENEE</title>
<style>
:root{
  --azul:#0d2c54; --azul2:#123a6d; --azul3:#1b4f8f;
  --cielo:#e8f0fa; --borde:#d3dfee; --texto:#1c2b3a; --gris:#66788e;
  --verde:#0e7c4f; --verde-bg:#e2f5ec; --ambar:#b45309; --ambar-bg:#fdf0dd;
  --rojo:#b3261e; --rojo-bg:#fbe9e7; --blanco:#ffffff; --fondo:#f2f6fb;
  --sombra:0 2px 10px rgba(13,44,84,.10);
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--fondo);color:var(--texto);font-size:14px}
button{cursor:pointer;font-family:inherit}
input,select{font-family:inherit;font-size:14px}

/* ===== LOGIN ===== */
#login{position:fixed;inset:0;background:linear-gradient(140deg,var(--azul) 0%,var(--azul3) 60%,#2a6ab5 100%);display:flex;align-items:center;justify-content:center;z-index:100}
.login-card{background:var(--blanco);border-radius:14px;padding:38px 36px;width:min(400px,92vw);box-shadow:0 20px 60px rgba(0,0,0,.35)}
.login-card h1{font-size:20px;color:var(--azul);margin-bottom:4px}
.login-card .sub{color:var(--gris);font-size:13px;margin-bottom:24px}
.campo{margin-bottom:14px}
.campo label{display:block;font-size:12px;font-weight:600;color:var(--azul);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px}
.campo input,.campo select{width:100%;padding:10px 12px;border:1.5px solid var(--borde);border-radius:8px;outline:none;transition:border .15s}
.campo input:focus,.campo select:focus{border-color:var(--azul3)}
.btn{background:var(--azul);color:#fff;border:none;border-radius:8px;padding:11px 18px;font-size:14px;font-weight:600;transition:background .15s}
.btn:hover{background:var(--azul3)}
.btn.full{width:100%}
.btn.sec{background:var(--cielo);color:var(--azul)}
.btn.sec:hover{background:var(--borde)}
.btn.peq{padding:6px 12px;font-size:12.5px}
.btn.peligro{background:var(--rojo)}
.login-err{color:var(--rojo);font-size:13px;margin-top:10px;display:none;text-align:center}
.marca{display:flex;align-items:center;gap:10px;margin-bottom:20px}
.marca .logo{width:44px;height:44px;border-radius:10px;background:var(--azul);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;letter-spacing:.5px}

/* ===== APP ===== */
#app{display:none;min-height:100vh}
header{background:var(--azul);color:#fff;padding:0 22px;display:flex;align-items:center;gap:16px;height:58px;position:sticky;top:0;z-index:50;box-shadow:var(--sombra)}
header .logo{width:34px;height:34px;border-radius:8px;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px}
header h1{font-size:15.5px;font-weight:600}
header .sub{font-size:11.5px;opacity:.75}
header .der{margin-left:auto;display:flex;align-items:center;gap:12px}
.chip-user{background:rgba(255,255,255,.13);border-radius:20px;padding:5px 14px;font-size:12.5px;display:flex;align-items:center;gap:8px}
.chip-user .rol{background:rgba(255,255,255,.2);border-radius:10px;padding:1px 8px;font-size:10.5px;text-transform:uppercase;letter-spacing:.5px}
.btn-salir{background:transparent;border:1px solid rgba(255,255,255,.35);color:#fff;border-radius:8px;padding:6px 13px;font-size:12.5px}
.btn-salir:hover{background:rgba(255,255,255,.12)}

nav{background:var(--blanco);border-bottom:1px solid var(--borde);padding:0 22px;display:flex;gap:2px;overflow-x:auto;position:sticky;top:58px;z-index:49}
nav button{background:none;border:none;padding:13px 16px;font-size:13.5px;font-weight:600;color:var(--gris);border-bottom:3px solid transparent;white-space:nowrap}
nav button.act{color:var(--azul);border-bottom-color:var(--azul)}
nav button:hover{color:var(--azul)}

main{padding:16px 14px;max-width:none;margin:0 auto}
.vista{display:none}
.vista.act{display:block}

/* KPIs */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-bottom:20px}
.kpi{background:var(--blanco);border-radius:12px;padding:16px 18px;box-shadow:var(--sombra);border-left:4px solid var(--azul)}
.kpi.verde{border-left-color:var(--verde)}
.kpi.ambar{border-left-color:var(--ambar)}
.kpi.rojo{border-left-color:var(--rojo)}
.kpi .et{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--gris);font-weight:700}
.kpi .val{font-size:22px;font-weight:800;color:var(--azul);margin-top:4px;font-variant-numeric:tabular-nums}
.kpi.verde .val{color:var(--verde)} .kpi.ambar .val{color:var(--ambar)} .kpi.rojo .val{color:var(--rojo)}
.kpi .det{font-size:11.5px;color:var(--gris);margin-top:3px}

/* Panel / tabla */
.panel{background:var(--blanco);border-radius:12px;box-shadow:var(--sombra);margin-bottom:20px;overflow:hidden}
.panel-cab{padding:14px 18px;border-bottom:1px solid var(--borde);display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.panel-cab h2{font-size:15px;color:var(--azul)}
.panel-cab .der{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap}
.filtros{padding:12px 18px;display:flex;gap:10px;flex-wrap:wrap;border-bottom:1px solid var(--borde);background:#fafcff}
.filtros input,.filtros select{padding:8px 11px;border:1.5px solid var(--borde);border-radius:8px;outline:none}
.filtros input:focus,.filtros select:focus{border-color:var(--azul3)}
.filtros input[type=search]{flex:1;min-width:180px}
.t-scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:12px}
th{background:var(--cielo);color:var(--azul);text-align:left;padding:7px 6px;font-size:10px;text-transform:uppercase;letter-spacing:.2px;white-space:nowrap;position:sticky;top:0}
td{padding:6px 6px;border-bottom:1px solid #eef3f9;white-space:nowrap;font-variant-numeric:tabular-nums}
td.envuelve{white-space:normal;line-height:1.25}
tr:hover td{background:#f6faff}
td.num{text-align:right;font-weight:600}
tfoot td{background:var(--cielo);font-weight:800;color:var(--azul)}
.pill{display:inline-block;padding:2px 8px;border-radius:12px;font-size:10px;font-weight:700}
.pill.pagado{background:var(--verde-bg);color:var(--verde)}
.pill.pendiente{background:var(--ambar-bg);color:var(--ambar)}
.pill.critico{background:var(--rojo-bg);color:var(--rojo)}
.check{display:inline-block;width:16px;text-align:center;font-weight:700}
.check.si{color:var(--verde)} .check.no{color:#c3ccd8}
.dias-alerta{color:var(--rojo);font-weight:700}
.acciones-td button{background:none;border:none;font-size:15px;padding:2px 5px;opacity:.65}
.acciones-td button:hover{opacity:1}
.vacio{padding:36px;text-align:center;color:var(--gris)}
.pie-tabla{padding:10px 18px;font-size:12px;color:var(--gris);display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px}

/* Barras informe */
.barras{padding:16px 18px}
.barra-fila{display:grid;grid-template-columns:160px 1fr 130px;gap:12px;align-items:center;margin-bottom:9px}
.barra-fila .et{font-size:12.5px;font-weight:600;color:var(--texto);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.barra-pista{background:#edf2f9;border-radius:6px;height:20px;overflow:hidden;display:flex}
.barra-seg{height:100%}
.barra-seg.v{background:var(--verde)} .barra-seg.a{background:#e8a33d}
.barra-fila .val{font-size:12px;color:var(--gris);text-align:right;font-variant-numeric:tabular-nums}
.leyenda{display:flex;gap:16px;padding:0 18px 14px;font-size:12px;color:var(--gris)}
.leyenda span::before{content:'';display:inline-block;width:11px;height:11px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.leyenda .lv::before{background:var(--verde)} .leyenda .la::before{background:#e8a33d}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:900px){.grid2{grid-template-columns:1fr}}

/* Modal */
.modal-fondo{position:fixed;inset:0;background:rgba(13,44,84,.45);display:none;align-items:flex-start;justify-content:center;z-index:80;padding:40px 16px;overflow-y:auto}
.modal-fondo.act{display:flex}
.modal{background:var(--blanco);border-radius:14px;width:min(680px,100%);box-shadow:0 24px 70px rgba(0,0,0,.3)}
.modal-cab{padding:16px 20px;border-bottom:1px solid var(--borde);display:flex;align-items:center}
.modal-cab h3{font-size:15.5px;color:var(--azul)}
.modal-cab button{margin-left:auto;background:none;border:none;font-size:20px;color:var(--gris)}
.modal-cuerpo{padding:20px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-grid .ancho{grid-column:1/-1}
@media(max-width:600px){.form-grid{grid-template-columns:1fr}}
.checks-grupo{display:flex;gap:16px;flex-wrap:wrap;padding:8px 0}
.checks-grupo label{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;cursor:pointer}
.modal-pie{padding:14px 20px;border-top:1px solid var(--borde);display:flex;gap:10px;justify-content:flex-end}
.nota{background:var(--cielo);border-radius:8px;padding:10px 14px;font-size:12.5px;color:var(--azul2);margin-top:12px}
.aviso-estado{font-size:12px;color:var(--gris);padding:6px 0}

/* Usuarios */
.tarjetas-u{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px;padding:18px}
.tarjeta-u{border:1.5px solid var(--borde);border-radius:11px;padding:14px 16px}
.tarjeta-u .nom{font-weight:700;color:var(--azul)}
.tarjeta-u .usr{font-size:12px;color:var(--gris);margin:2px 0 8px}
.tarjeta-u .acc{display:flex;gap:8px;margin-top:10px}

.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--azul);color:#fff;padding:11px 22px;border-radius:10px;font-size:13.5px;box-shadow:0 8px 30px rgba(0,0,0,.3);transition:transform .25s;z-index:99}
.toast.ver{transform:translateX(-50%) translateY(0)}

/* Seguimiento de beneficiarios */
.seg-banda{padding:10px 18px;color:#fff;font-weight:700;font-size:14px;letter-spacing:.3px}
.seg-banda.centros{background:var(--azul)}
.seg-banda.empleados{background:var(--verde)}
.tabla-seg th{background:var(--azul2);color:#fff}
.tabla-seg.empleados th{background:var(--verde)}
.celda-pend{font-weight:700;text-align:center;border-radius:6px}
.celda-pend.con{background:var(--ambar-bg);color:var(--ambar)}
.celda-pend.sin{background:var(--verde-bg);color:var(--verde)}
.pct-avance{font-weight:800}
.subtotal-seg td{background:var(--azul);color:#fff;font-weight:800}
.tabla-seg.empleados .subtotal-seg td{background:var(--verde)}
.seg-actualizado{padding:8px 18px;font-size:12.5px;color:var(--verde);background:#f4fbf7;border-bottom:1px solid var(--borde)}

@media print{header,nav,.filtros,.panel-cab .der,.acciones-td,#login{display:none!important}main{padding:0}.panel{box-shadow:none;border:1px solid #ccc}}
</style>
</head>
<body>

<!-- ================= LOGIN ================= -->
<div id="login">
  <div class="login-card">
    <div class="marca">
      <div class="logo">ENEE</div>
      <div>
        <h1>Solicitudes de Pago DBS 2026</h1>
        <div class="sub">Departamento de Bienestar Social · DDH</div>
      </div>
    </div>
    <div class="campo">
      <label>Usuario</label>
      <input id="l-usr" type="text" autocomplete="username" placeholder="ej. wendy">
    </div>
    <div class="campo">
      <label>Contraseña</label>
      <input id="l-pass" type="password" autocomplete="current-password" placeholder="••••••••">
    </div>
    <button class="btn full" onclick="entrar()">Iniciar sesión</button>
    <div class="login-err" id="l-err">Usuario o contraseña incorrectos.</div>
  </div>
</div>

<!-- ================= APP ================= -->
<div id="app">
<header>
  <div class="logo">ENEE</div>
  <div>
    <h1>Solicitudes de Pago DBS 2026</h1>
    <div class="sub">Dirección de Desarrollo Humano · Bienestar Social</div>
  </div>
  <div class="der">
    <div class="chip-user"><span id="u-nombre"></span><span class="rol" id="u-rol"></span></div>
    <button class="btn-salir" onclick="salir()">Salir</button>
  </div>
</header>

<nav id="nav">
  <button data-v="clausulas" class="act" onclick="ir('clausulas')">Pago de Cláusulas</button>
  <button data-v="r55" onclick="ir('r55')">Reembolsos C.55</button>
  <button data-v="r40" onclick="ir('r40')">Reembolsos C.40</button>
  <button data-v="informes" onclick="ir('informes')">📈 Informes</button>
  <button data-v="usuarios" id="tab-usuarios" onclick="ir('usuarios')" style="display:none">👥 Usuarios</button>
</nav>

<main>
  <!-- HOJAS DE DATOS (generadas por JS) -->
  <div class="vista act" id="v-clausulas"></div>
  <div class="vista" id="v-r55"></div>
  <div class="vista" id="v-r40"></div>

  <!-- INFORMES -->
  <div class="vista" id="v-informes">
    <div class="panel">
      <div class="panel-cab">
        <h2>Informe por hoja</h2>
        <div class="der">
          <select id="inf-hoja" onchange="renderInforme()">
            <option value="clausulas">Pago de Cláusulas</option>
            <option value="r55">Reembolsos C.55</option>
            <option value="r40">Reembolsos C.40</option>
            <option value="seguimiento">Seguimiento de Beneficiarios</option>
          </select>
          <button class="btn peq sec" onclick="window.print()">🖨️ Imprimir informe</button>
          <button class="btn peq" onclick="respaldoJSON()">⬇ Respaldo (JSON)</button>
          <label class="btn peq sec" style="display:inline-flex;align-items:center">⬆ Restaurar
            <input type="file" accept=".json" style="display:none" onchange="importarJSON(this)">
          </label>
        </div>
      </div>
      <div class="pie-tabla">Los registros nuevos viven en la sesión actual: descarga el respaldo al terminar y restáuralo al iniciar. Para guardado automático compartido, el sistema puede conectarse a Google Sheets vía Apps Script.</div>
    </div>
    <div id="inf-contenido"></div>
  </div>

  <!-- USUARIOS -->
  <div class="vista" id="v-usuarios">
    <div class="panel">
      <div class="panel-cab">
        <h2>Usuarios del sistema</h2>
        <div class="der"><button class="btn peq" onclick="abrirModalUsuario()">＋ Nuevo usuario</button></div>
      </div>
      <div class="tarjetas-u" id="lista-usuarios"></div>
      <div class="pie-tabla">Los roles: <b>Administrador</b> gestiona todo incluyendo usuarios · <b>Editor</b> agrega y edita registros · <b>Lector</b> solo consulta e imprime informes.</div>
    </div>
  </div>
</main>
</div>

<!-- MODAL REGISTRO -->
<div class="modal-fondo" id="m-reg">
  <div class="modal">
    <div class="modal-cab"><h3 id="m-reg-titulo">Nuevo registro</h3><button onclick="cerrarModal('m-reg')">✕</button></div>
    <div class="modal-cuerpo">
      <div class="form-grid" id="m-reg-campos"></div>
      <div class="checks-grupo" id="m-reg-checks"></div>
      <div class="aviso-estado" id="m-reg-estado"></div>
    </div>
    <div class="modal-pie">
      <button class="btn sec" onclick="cerrarModal('m-reg')">Cancelar</button>
      <button class="btn" onclick="guardarRegistro()">Guardar registro</button>
    </div>
  </div>
</div>

<!-- MODAL USUARIO -->
<div class="modal-fondo" id="m-usr">
  <div class="modal">
    <div class="modal-cab"><h3 id="m-usr-titulo">Nuevo usuario</h3><button onclick="cerrarModal('m-usr')">✕</button></div>
    <div class="modal-cuerpo">
      <div class="form-grid">
        <div class="campo"><label>Nombre completo</label><input id="u-f-nombre"></div>
        <div class="campo"><label>Usuario (para ingresar)</label><input id="u-f-usr"></div>
        <div class="campo"><label>Contraseña</label><input id="u-f-pass" type="text" placeholder="Dejar vacío para no cambiar"></div>
        <div class="campo"><label>Rol</label>
          <select id="u-f-rol">
            <option value="admin">Administrador</option>
            <option value="editor" selected>Editor</option>
            <option value="lector">Lector</option>
          </select>
        </div>
      </div>
      <div class="nota">⚠️ Este control de acceso es de nivel organizativo (funciona dentro del archivo). Para seguridad real con datos sensibles, conecta el sistema a Google Apps Script con validación en el servidor, como en Control de Documentos DBS.</div>
    </div>
    <div class="modal-pie">
      <button class="btn sec" onclick="cerrarModal('m-usr')">Cancelar</button>
      <button class="btn" onclick="guardarUsuario()">Guardar usuario</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ============================================================
   DATOS EMBEBIDOS (extraídos de SOLICITUDES_DE_PAGO_DBS2026.xlsx)
