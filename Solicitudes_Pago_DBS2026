function entrar(){
  const u = document.getElementById('l-usr').value.trim().toLowerCase();
  const p = document.getElementById('l-pass').value;
  const encontrado = USUARIOS.find(x => x.usr===u && x.hash===h(p));
  if(!encontrado){ document.getElementById('l-err').style.display='block'; return; }
  sesion = encontrado;
  document.getElementById('l-err').style.display='none';
  document.getElementById('login').style.display='none';
  document.getElementById('app').style.display='block';
  document.getElementById('u-nombre').textContent = sesion.nombre;
  document.getElementById('u-rol').textContent = ROL_NOMBRE[sesion.rol];
  document.getElementById('tab-usuarios').style.display = sesion.rol==='admin' ? '' : 'none';
  renderTodo();
}
function salir(){
  sesion=null;
  document.getElementById('app').style.display='none';
  document.getElementById('login').style.display='flex';
  document.getElementById('l-pass').value='';
}
document.getElementById('l-pass').addEventListener('keydown', e=>{ if(e.key==='Enter') entrar(); });
function puedeEditar(){ return sesion && (sesion.rol==='admin'||sesion.rol==='editor'); }

