    <div class="kpi"><div class="et">Monto total</div><div class="val">${L(s.tot)}</div></div>
    <div class="kpi verde"><div class="et">Pagado</div><div class="val">${L(s.pag)}</div><div class="det">${s.nPag} solicitudes</div></div>
    <div class="kpi ambar"><div class="et">Pendiente</div><div class="val">${L(s.pend)}</div><div class="det">${s.nPend} solicitudes</div></div>
  </div>
  <div class="grid2">
    <div class="panel">
      <div class="panel-cab"><h2>Resumen mensual</h2></div>
      <div class="t-scroll"><table>
        <thead><tr><th>Mes</th><th>N°</th><th>Total</th><th>Pagado</th><th>% Avance</th></tr></thead>
        <tbody>${claves.map(m=>{const x=porMes[m];return `<tr><td>${MESES[m]}</td><td class="num">${x.n}</td><td class="num">${L(x.tot)}</td><td class="num">${L(x.pag)}</td><td class="num">${x.tot?Math.round(x.pag/x.tot*100):0}%</td></tr>`}).join('')}</tbody>
      </table></div>
    </div>
    <div class="panel">
      <div class="panel-cab"><h2>Antigüedad de pendientes</h2></div>
      <div class="t-scroll"><table>
        <thead><tr><th>Rango</th><th>Solicitudes</th><th>Monto pendiente</th></tr></thead>
        <tbody>${aging.map(a=>`<tr><td>${a.et}</td><td class="num">${a.n}</td><td class="num ${a.min>30&&a.n?'dias-alerta':''}">${L(a.tot)}</td></tr>`).join('')}</tbody>
      </table></div>
      <div class="pie-tabla">Los pendientes con más de 30 días se marcan como críticos ⚠ en cada hoja.</div>
    </div>
  </div>
  <div class="panel">
    <div class="panel-cab"><h2>Montos por ${cfg.agrupadorEt}</h2></div>
    <div class="barras">${grupos.slice(0,12).map(([g,x])=>{
      const pctT = x.tot/maxG*100, pctP = x.tot? x.pag/x.tot : 0;
      return `<div class="barra-fila"><div class="et" title="${esc(g)}">${esc(g)}</div>
        <div class="barra-pista" style="width:${pctT}%;min-width:40px">
          <div class="barra-seg v" style="width:${pctP*100}%"></div>
          <div class="barra-seg a" style="width:${(1-pctP)*100}%"></div></div>
        <div class="val">${L(x.tot)} · ${x.n}</div></div>`;
    }).join('')}</div>
    <div class="leyenda"><span class="lv">Pagado</span><span class="la">Pendiente</span></div>
  </div>
  <div class="panel">
    <div class="panel-cab"><h2>Carga por responsable</h2></div>
    <div class="t-scroll"><table>
      <thead><tr><th>Responsable</th><th>Solicitudes</th><th>Pendientes</th><th>Monto gestionado</th></tr></thead>
      <tbody>${Object.entries(porResp).sort((a,b)=>b[1].n-a[1].n).map(([g,x])=>
        `<tr><td>${esc(g)}</td><td class="num">${x.n}</td><td class="num">${x.pend}</td><td class="num">${L(x.tot)}</td></tr>`).join('')}</tbody>
    </table></div>
  </div>`;
}

/* ============================================================
   SEGUIMIENTO DE PAGOS POR BENEFICIARIO (calculado en vivo
   desde Reembolsos C.55 — se actualiza al agregar registros)
   ============================================================ */
function renderSeguimiento(){
  // Agrupar por beneficiario normalizado (evita duplicados por espacios/mayúsculas)
  const grupos = {};
  for(const r of DATOS.r55){
    const nombre = String(r.favor||'').replace(/\s+/g,' ').trim();
    if(!nombre) continue;
    const clave = nombre.toUpperCase();
    if(!grupos[clave]){
      grupos[clave] = {nombre, tipo: String(r.tipo||'').trim(), n:0, pag:0, pend:0, mTot:0, mPag:0};
    }
    const g = grupos[clave];
    if(!g.tipo && r.tipo) g.tipo = String(r.tipo).trim(); // completar tipo si faltaba
    g.n++;
    g.mTot += +r.valor||0;
    if(estadoDe(r)==='PAGADO'){ g.pag++; g.mPag += +r.valor||0; }
    else g.pend++;
  }
  const lista = Object.values(grupos);
  const centros   = lista.filter(g=>g.tipo==='Centro de Servicio').sort((a,b)=>a.nombre.localeCompare(b.nombre,'es'));
  const empleados = lista.filter(g=>g.tipo!=='Centro de Servicio').sort((a,b)=>a.nombre.localeCompare(b.nombre,'es'));

  const hoyTxt = new Date().toLocaleDateString('es-HN',{day:'2-digit',month:'2-digit',year:'numeric'});

  function tabla(items, clase, etiqueta, icono){
    const st = items.reduce((s,g)=>({n:s.n+g.n, pag:s.pag+g.pag, pend:s.pend+g.pend, mTot:s.mTot+g.mTot, mPag:s.mPag+g.mPag}),{n:0,pag:0,pend:0,mTot:0,mPag:0});
    const filas = items.map((g,i)=>{
      const pct = g.mTot ? g.mPag/g.mTot*100 : 0;
      return `<tr data-nombre="${esc(g.nombre.toUpperCase())}" data-n="${g.n}" data-pag="${g.pag}" data-pend="${g.pend}" data-mtot="${g.mTot}" data-mpag="${g.mPag}">
        <td class="num seg-num" style="color:var(--gris)">${i+1}</td>
        <td style="white-space:normal;min-width:220px;font-weight:600">${esc(g.nombre)}</td>
        <td>${esc(g.tipo||'Empleado')}</td>
        <td class="num">${g.n}</td>
        <td class="num" style="color:var(--verde)">${g.pag}</td>
        <td><div class="celda-pend ${g.pend>0?'con':'sin'}">${g.pend}</div></td>
        <td class="num">${L(g.mTot)}</td>
        <td class="num" style="color:var(--verde)">${L(g.mPag)}</td>
        <td class="num" style="color:${g.mTot-g.mPag>0.005?'var(--rojo)':'var(--verde)'}">${L(g.mTot-g.mPag)}</td>
        <td class="num pct-avance" style="color:${pct>=100?'var(--verde)':pct>=75?'var(--azul3)':'var(--ambar)'}">${pct.toFixed(1)}%</td>
      </tr>`;
    }).join('');
    const pctT = st.mTot ? st.mPag/st.mTot*100 : 0;
    return `<div class="panel">
      <div class="seg-banda ${clase}" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <span>${icono}&nbsp; ${etiqueta}</span>
        <input type="search" id="q-seg-${clase}" placeholder="Buscar ${clase==='centros'?'centro de servicio':'empleado'}…"
          oninput="filtrarSeg('${clase}', this.value)"
          style="margin-left:auto;flex:1;max-width:320px;min-width:180px;padding:7px 12px;border:none;border-radius:8px;font-size:13px;outline:none;color:var(--texto)">
      </div>
      <div class="t-scroll"><table class="tabla-seg ${clase}" id="t-seg-${clase}">
        <thead><tr>
          <th>N°</th><th>Nombre del beneficiario</th><th>Tipo</th>
          <th>Total pagos</th><th>Pagados</th><th>Pendientes</th>
          <th>Monto total (L)</th><th>Monto pagado (L)</th><th>Monto pend. (L)</th><th>% Avance</th>
        </tr></thead>
        <tbody>${filas || `<tr><td colspan="10"><div class="vacio">Sin registros de este tipo todavía.</div></td></tr>`}</tbody>
        <tfoot><tr class="subtotal-seg">
          <td colspan="3" id="seg-st-et-${clase}">SUBTOTAL</td>
          <td class="num">${st.n}</td><td class="num">${st.pag}</td><td class="num">${st.pend}</td>
          <td class="num">${L(st.mTot)}</td><td class="num">${L(st.mPag)}</td>
          <td class="num">${L(st.mTot-st.mPag)}</td><td class="num">${pctT.toFixed(1)}%</td>
        </tr></tfoot>
      </table></div>
    </div>`;
  }

  const stG = lista.reduce((s,g)=>({n:s.n+g.n, pend:s.pend+g.pend, mTot:s.mTot+g.mTot, mPag:s.mPag+g.mPag}),{n:0,pend:0,mTot:0,mPag:0});

  document.getElementById('inf-contenido').innerHTML = `
  <div class="panel">
    <div class="seg-banda centros" style="text-align:center;font-size:15px">SEGUIMIENTO DE PAGOS POR BENEFICIARIO — REEMBOLSOS 2026</div>
    <div class="seg-actualizado">✅ Actualizado: ${hoyTxt} &nbsp;|&nbsp; Se actualiza automáticamente al agregar registros en Reembolsos C.55</div>
  </div>
  <div class="kpis">
    <div class="kpi"><div class="et">Beneficiarios</div><div class="val">${lista.length}</div><div class="det">${centros.length} centros · ${empleados.length} empleados</div></div>
    <div class="kpi"><div class="et">Pagos registrados</div><div class="val">${stG.n}</div></div>
    <div class="kpi verde"><div class="et">Monto pagado</div><div class="val">${L(stG.mPag)}</div><div class="det">${stG.mTot?Math.round(stG.mPag/stG.mTot*100):0}% de avance</div></div>
    <div class="kpi ambar"><div class="et">Pagos pendientes</div><div class="val">${stG.pend}</div><div class="det">${L(stG.mTot-stG.mPag)} por pagar</div></div>
  </div>
  ${tabla(centros, 'centros', 'CENTROS DE SERVICIO', '🏥')}
  ${tabla(empleados, 'empleados', 'EMPLEADOS', '👤')}`;
}

/* Filtra las filas del seguimiento sin reconstruir la tabla
   (el cursor no se pierde) y recalcula el subtotal visible. */
function filtrarSeg(clase, texto){
  const q = texto.trim().toUpperCase();
  const tabla = document.getElementById('t-seg-'+clase);
  if(!tabla) return;
  let n=0, pag=0, pend=0, mTot=0, mPag=0, vis=0, num=1;
  tabla.querySelectorAll('tbody tr[data-nombre]').forEach(tr=>{
    const ok = !q || tr.dataset.nombre.includes(q);
    tr.style.display = ok ? '' : 'none';
    if(ok){
      vis++;
      tr.querySelector('.seg-num').textContent = num++;
      n    += +tr.dataset.n;    pag  += +tr.dataset.pag;
      pend += +tr.dataset.pend; mTot += +tr.dataset.mtot;
      mPag += +tr.dataset.mpag;
    }
  });
  const pie = tabla.querySelector('tfoot tr');
  const c = pie.querySelectorAll('td');
  c[0].textContent = q ? `SUBTOTAL (${vis} coincidencia${vis===1?'':'s'})` : 'SUBTOTAL';
  c[1].textContent = n; c[2].textContent = pag; c[3].textContent = pend;
  c[4].textContent = L(mTot); c[5].textContent = L(mPag);
  c[6].textContent = L(mTot-mPag);
  c[7].textContent = (mTot ? mPag/mTot*100 : 0).toFixed(1)+'%';
}

/* ============================================================
   AGREGAR / EDITAR REGISTROS
   ============================================================ */
let modalCtx = {hoja:null, idx:-1};

function abrirModalRegistro(hoja, idx){
  if(!puedeEditar()){ toast('Tu rol de Lector no permite editar.'); return; }
  modalCtx = {hoja, idx};
  const cfg = HOJAS[hoja];
  const r = idx>=0 ? DATOS[hoja][idx] : {};
  document.getElementById('m-reg-titulo').textContent =
    (idx>=0?'Editar registro — ':'Nuevo registro — ') + cfg.titulo;

  document.getElementById('m-reg-campos').innerHTML = cfg.cols.map(c=>{
    const val = r[c.k] ?? (c.k==='realizado' ? sesion.nombre : (c.k==='fecha' ? new Date().toISOString().slice(0,10) : ''));
    if(c.tipo==='select')
      return `<div class="campo"><label>${c.et}${c.req?' *':''}</label>
        <select id="f-${c.k}"><option value="">—</option>${c.ops.map(o=>`<option ${String(val)===o?'selected':''}>${o}</option>`).join('')}</select></div>`;
    return `<div class="campo ${c.k==='favor'?'ancho':''}"><label>${c.et}${c.req?' *':''}</label>
      <input id="f-${c.k}" type="${c.tipo}" ${c.tipo==='number'?'step="0.01" min="0"':''} value="${esc(val)}"></div>`;
  }).join('');

  document.getElementById('m-reg-checks').innerHTML = CHECKS.map(c=>
    `<label><input type="checkbox" id="f-${c}" ${r[c]==='SI'?'checked':''} onchange="previsualizarEstado()">
     ${c.charAt(0).toUpperCase()+c.slice(1)}</label>`).join('');
  previsualizarEstado();
  document.getElementById('m-reg').classList.add('act');
}
function previsualizarEstado(){
  const pag = document.getElementById('f-pagado')?.checked;
  document.getElementById('m-reg-estado').innerHTML =
    `Estado calculado automáticamente: <span class="pill ${pag?'pagado':'pendiente'}">${pag?'PAGADO':'PENDIENTE'}</span> — depende únicamente de la casilla <b>Pagado</b>.`;
}
function guardarRegistro(){
  const {hoja, idx} = modalCtx;
  const cfg = HOJAS[hoja];
  const nuevo = idx>=0 ? {...DATOS[hoja][idx]} : {};
  for(const c of cfg.cols){
    let v = document.getElementById('f-'+c.k).value.trim();
    if(c.req && !v){ toast('Completa el campo obligatorio: '+c.et); return; }
    nuevo[c.k] = c.tipo==='number' ? (v===''?0:parseFloat(v)) : v;
  }
  for(const c of CHECKS) nuevo[c] = document.getElementById('f-'+c).checked ? 'SI':'NO';
  nuevo.estado = estadoDe(nuevo);
  if(idx>=0) DATOS[hoja][idx]=nuevo; else DATOS[hoja].push(nuevo);
  cerrarModal('m-reg');
  renderTodo();
  toast(idx>=0?'Registro actualizado.':'Registro agregado. Recuerda descargar el respaldo antes de cerrar.');
}

/* ============================================================
   USUARIOS (solo admin)
   ============================================================ */
let usrEdit = -1;
function renderUsuarios(){
  document.getElementById('lista-usuarios').innerHTML = USUARIOS.map((u,i)=>`
    <div class="tarjeta-u">
      <div class="nom">${esc(u.nombre)}</div>
      <div class="usr">@${esc(u.usr)}</div>
      <span class="pill ${u.rol==='admin'?'pagado':u.rol==='editor'?'pendiente':''}" style="${u.rol==='lector'?'background:var(--cielo);color:var(--azul2)':''}">${ROL_NOMBRE[u.rol]}</span>
      <div class="acc">
        <button class="btn peq sec" onclick="abrirModalUsuario(${i})">Editar</button>
        ${u.usr!==sesion.usr?`<button class="btn peq peligro" onclick="borrarUsuario(${i})">Eliminar</button>`:''}
      </div>
    </div>`).join('');
}
function abrirModalUsuario(i=-1){
  usrEdit = i;
  const u = i>=0 ? USUARIOS[i] : null;
  document.getElementById('m-usr-titulo').textContent = u?'Editar usuario':'Nuevo usuario';
  document.getElementById('u-f-nombre').value = u?u.nombre:'';
  document.getElementById('u-f-usr').value = u?u.usr:'';
  document.getElementById('u-f-usr').disabled = !!u;
  document.getElementById('u-f-pass').value = '';
  document.getElementById('u-f-pass').placeholder = u?'Dejar vacío para no cambiar':'Contraseña inicial';
  document.getElementById('u-f-rol').value = u?u.rol:'editor';
  document.getElementById('m-usr').classList.add('act');
}
function guardarUsuario(){
  const nombre = document.getElementById('u-f-nombre').value.trim();
  const usr = document.getElementById('u-f-usr').value.trim().toLowerCase();
  const pass = document.getElementById('u-f-pass').value;
  const rol = document.getElementById('u-f-rol').value;
  if(!nombre || !usr){ toast('Nombre y usuario son obligatorios.'); return; }
  if(usrEdit<0){
    if(USUARIOS.some(x=>x.usr===usr)){ toast('Ese usuario ya existe.'); return; }
    if(!pass){ toast('Define una contraseña inicial.'); return; }
    USUARIOS.push({usr, nombre, rol, hash:h(pass)});
  } else {
    const u = USUARIOS[usrEdit];
    u.nombre=nombre; u.rol=rol;
    if(pass) u.hash=h(pass);
  }
  cerrarModal('m-usr'); renderUsuarios();
  toast('Usuario guardado. Para que sea permanente, descarga el respaldo y actualiza el archivo.');
}
function borrarUsuario(i){
  if(USUARIOS.filter(u=>u.rol==='admin').length===1 && USUARIOS[i].rol==='admin'){
    toast('No puedes eliminar al único administrador.'); return;
  }
  if(confirm('¿Eliminar al usuario '+USUARIOS[i].nombre+'?')){ USUARIOS.splice(i,1); renderUsuarios(); }
}

/* ============================================================
   EXPORTAR / RESPALDO
   ============================================================ */
function exportarCSV(hoja){
  const cfg = HOJAS[hoja];
  const cab = [...cfg.cols.map(c=>c.et),'Verificado','Aprobado','Firmado','Pagado','Estado','Días'];
  const filas = DATOS[hoja].map(r=>[
    ...cfg.cols.map(c=>r[c.k]??''),
    ...CHECKS.map(c=>r[c]??'NO'),
    estadoDe(r), diasDe(r)??''
  ]);
  const csv = '\uFEFF' + [cab,...filas].map(f=>f.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(';')).join('\r\n');
  descargar(csv, cfg.titulo.replace(/\s+/g,'_')+'_2026.csv', 'text/csv;charset=utf-8');
}
function respaldoJSON(){
  const paquete = {fecha:new Date().toISOString(), datos:DATOS, usuarios:USUARIOS};
  descargar(JSON.stringify(paquete,null,1), 'respaldo_solicitudes_dbs_'+new Date().toISOString().slice(0,10)+'.json', 'application/json');
  toast('Respaldo descargado.');
}
function importarJSON(input){
  const file = input.files[0]; if(!file) return;
  const fr = new FileReader();
  fr.onload = ()=>{
    try{
      const p = JSON.parse(fr.result);
      if(p.datos){ Object.assign(DATOS, p.datos); }
      if(p.usuarios){ USUARIOS = p.usuarios; }
      renderTodo(); toast('Respaldo restaurado correctamente.');
    }catch(e){ toast('El archivo no es un respaldo válido.'); }
  };
  fr.readAsText(file); input.value='';
}
function descargar(contenido, nombre, tipo){
  const b = new Blob([contenido],{type:tipo});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(b); a.download = nombre; a.click();
  URL.revokeObjectURL(a.href);
}

/* ============================================================
   UTILIDADES
   ============================================================ */
function cerrarModal(id){ document.getElementById(id).classList.remove('act'); }
document.querySelectorAll('.modal-fondo').forEach(m=>m.addEventListener('click',e=>{ if(e.target===m) m.classList.remove('act'); }));
let toastT;
function toast(msg){
  const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('ver');
  clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove('ver'), 3600);
}
function renderTodo(){
  renderHoja('clausulas'); renderHoja('r55'); renderHoja('r40');
  renderInforme();   // los informes (incluido Seguimiento) se refrescan siempre
  if(sesion && sesion.rol==='admin') renderUsuarios();
}

