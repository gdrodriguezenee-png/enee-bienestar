/* ============================================================
   FÓRMULAS MEJORADAS
   - Estado se deriva SOLO de "Pagado" (una sola fuente de verdad)
   - Días transcurridos se calculan en vivo contra la fecha actual
     (corrige los valores 1518/errores de filas vacías del Excel)
   ============================================================ */
function estadoDe(r){ return (r.pagado==='SI') ? 'PAGADO' : 'PENDIENTE'; }
function diasDe(r){
  if(!r.fecha) return null;
  const f = new Date(r.fecha+'T00:00:00');
  if(isNaN(f)) return null;
  return Math.floor((hoy0() - f)/86400000);
}
function hoy0(){ const d=new Date(); d.setHours(0,0,0,0); return d; }
function mesDe(r){
  if(!r.fecha) return null;
  const m = parseInt(r.fecha.slice(5,7),10);
  return isNaN(m)? null : m-1;
}
function L(n){ return 'L ' + Number(n||0).toLocaleString('es-HN',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function esc(s){ return String(s??'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

