function renderInforme(){
  const hoja = document.getElementById('inf-hoja').value;
  if(hoja==='seguimiento'){ renderSeguimiento(); return; }
  const cfg = HOJAS[hoja], d = DATOS[hoja];
  const s = statsHoja(hoja);

  // por mes
  const porMes = {};
  d.forEach(r=>{ const m=mesDe(r); if(m===null)return;
    porMes[m]=porMes[m]||{n:0,tot:0,pag:0};
    porMes[m].n++; porMes[m].tot+=+r.valor||0;
    if(estadoDe(r)==='PAGADO') porMes[m].pag+=+r.valor||0; });

  // por agrupador (cláusula / tipo / área)
  const porGrupo = {};
  d.forEach(r=>{ const g=String(r[cfg.agrupador]||'(sin dato)');
    porGrupo[g]=porGrupo[g]||{n:0,tot:0,pag:0};
    porGrupo[g].n++; porGrupo[g].tot+=+r.valor||0;
    if(estadoDe(r)==='PAGADO') porGrupo[g].pag+=+r.valor||0; });

  // por responsable
  const porResp = {};
  d.forEach(r=>{ const g=String(r.realizado||'(sin asignar)').trim()||'(sin asignar)';
    porResp[g]=porResp[g]||{n:0,pend:0,tot:0};
    porResp[g].n++; porResp[g].tot+=+r.valor||0;
    if(estadoDe(r)==='PENDIENTE') porResp[g].pend++; });

  // antigüedad de pendientes
  const rangos = [{et:'0–15 días',min:0,max:15},{et:'16–30 días',min:16,max:30},{et:'31–60 días',min:31,max:60},{et:'Más de 60 días',min:61,max:Infinity}];
  const aging = rangos.map(r=>({...r,n:0,tot:0}));
  d.forEach(r=>{ if(estadoDe(r)!=='PENDIENTE')return; const dias=diasDe(r); if(dias===null)return;
    const b=aging.find(a=>dias>=a.min&&dias<=a.max); if(b){b.n++; b.tot+=+r.valor||0;} });

  const grupos = Object.entries(porGrupo).sort((a,b)=>b[1].tot-a[1].tot);
  const maxG = Math.max(...grupos.map(([,x])=>x.tot),1);
